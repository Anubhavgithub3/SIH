{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/summary",
      "destination": "/api/index.py"
    },
    {
      "source": "/events",
      "destination": "/api/index.py"
    },
    {
      "source": "/logs",
      "destination": "/api/index.py"
    },
    {
      "source": "/overview",
      "destination": "/api/index.py"
    },
    {
      "source": "/ml/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
